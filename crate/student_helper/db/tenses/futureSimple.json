{
  "id": "futureSimple",
  "title": "Future Simple",
  "subtitle": "решение, прогноз, обещание о будущем",
  "ruleBlocks": [
    {
      "type": "heading",
      "text": "Когда используем Future Simple"
    },
    {
      "type": "text",
      "text": "Future Simple (will + V1) используем для спонтанных решений, прогнозов, обещаний, предложений и фактов о будущем."
    },
    {
      "type": "highlight",
      "title": "Основные случаи",
      "lines": [
        "решение в момент речи: I'll open the window.",
        "прогноз/мнение: I think it will rain.",
        "обещание/угроза/предложение: I will help you. / Will you have some tea?"
      ]
    },
    {
      "type": "table",
      "caption": "Формулы",
      "columns": [
        "Тип",
        "Формула",
        "Пример"
      ],
      "rows": [
        [
          "Утверждение",
          "S + will + V1",
          "She will call you later."
        ],
        [
          "Отрицание",
          "S + will not (won't) + V1",
          "She won't call today."
        ],
        [
          "Вопрос",
          "Will + S + V1?",
          "Will she call today?"
        ]
      ]
    },
    {
      "type": "table",
      "caption": "Маркеры",
      "columns": [
        "Тип",
        "Маркеры"
      ],
      "rows": [
        [
          "типичные",
          "tomorrow, next week, soon, later"
        ],
        [
          "прогноз",
          "I think, probably, maybe, I'm sure"
        ],
        [
          "обещание/предложение",
          "I promise, I will, Shall I...?"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "Future Simple vs be going to"
    },
    {
      "type": "highlight",
      "title": "Быстрое правило",
      "lines": [
        "will = решение сейчас / мнение / обещание",
        "be going to = план заранее или прогноз по видимым признакам"
      ]
    }
  ],
