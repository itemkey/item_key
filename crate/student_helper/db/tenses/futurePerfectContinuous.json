{
  "id": "futurePerfectContinuous",
  "title": "Future Perfect Continuous",
  "subtitle": "длительность процесса до момента в будущем",
  "ruleBlocks": [
    {
      "type": "heading",
      "text": "Когда используем Future Perfect Continuous"
    },
    {
      "type": "text",
      "text": "Future Perfect Continuous (will have been + V-ing) показывает, как долго действие будет продолжаться к определенному моменту в будущем."
    },
    {
      "type": "highlight",
      "title": "Ключевая идея",
      "lines": [
        "важна длительность к будущей точке: By June, I will have been working here for five years.",
        "часто с for + период и by + момент"
      ]
    },
    {
      "type": "table",
      "caption": "Формулы",
      "columns": [
        "Тип",
        "Формула",
        "Пример"
      ],
      "rows": [
        [
          "Утверждение",
          "S + will have been + V-ing",
          "I will have been studying for two hours by 9."
        ],
        [
          "Отрицание",
          "S + will not have been + V-ing",
          "I won't have been studying for two hours by 9."
        ],
        [
          "Вопрос",
          "Will + S + have been + V-ing?",
          "Will you have been studying for two hours by 9?"
        ]
      ]
    },
    {
      "type": "table",
      "caption": "Маркеры",
      "columns": [
        "Тип",
        "Маркеры"
      ],
      "rows": [
        [
          "длительность",
          "for two hours, for five years"
        ],
        [
          "будущая точка",
          "by 6 p.m., by next month, by the time"
        ],
        [
          "вопрос",
          "how long ... by ...?"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "Future Perfect vs Future Perfect Continuous"
    },
    {
      "type": "highlight",
      "title": "Разница",
      "lines": [
        "Future Perfect = завершение к сроку (will have done)",
        "Future Perfect Continuous = длительность к сроку (will have been doing)"
      ]
    }
  ],
