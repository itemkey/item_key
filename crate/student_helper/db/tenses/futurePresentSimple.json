      {
        "id": "formula",
        "title": "Формулы (Formula)",
        "kind": "input",
        "items": [
          {
            "id": "fpsf_f_1",
            "instruction": "Вставь форму",
            "prompt": "The bus ____ (leave) at 7 tomorrow.",
            "accepted": ["leaves"],
            "explain": "3-е лицо ед. числа: leaves."
          },
          {
            "id": "fpsf_f_2",
            "instruction": "Вставь форму",
            "prompt": "Our classes ____ (start) next Monday.",
            "accepted": ["start"],
            "explain": "Our classes (мн. число) -> start."
          },
          {
            "id": "fpsf_f_3",
            "instruction": "Сделай отрицание",
            "prompt": "The library ____ (not/open) on Sunday.",
            "accepted": ["doesn't open", "does not open"],
            "explain": "Отрицание в Present Simple: does not + V1."
          },
          {
            "id": "fpsf_f_4",
            "instruction": "Сделай вопрос",
            "prompt": "____ the train ____ (arrive) at 6:50?",
            "accepted": ["Does the train arrive"],
            "explain": "Вопрос: Does + S + V1?"
          },
          {
            "id": "fpsf_f_5",
            "instruction": "Вставь форму",
            "prompt": "The film ____ (begin) at 8:30.",
            "accepted": ["begins"],
            "explain": "3-е лицо ед. числа: begins."
          },
          {
            "id": "fpsf_f_6",
            "instruction": "Сделай вопрос",
            "prompt": "What time ____ the meeting ____ (finish)?",
            "accepted": ["does the meeting finish"],
            "explain": "Wh-question + does + subject + V1."
          }
        ]
      }
    ]
  }
