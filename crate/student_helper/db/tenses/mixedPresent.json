{
  "id": "mixedPresent",
  "title": "Mixed Present",
  "subtitle": "Present Simple + Present Continuous",
  "ruleBlocks": [
    {
      "type": "heading",
      "text": "Mixed Present: Present Simple vs Present Continuous"
    },
    {
      "type": "highlight",
      "title": "Супер-правило",
      "lines": [
        "Simple = habit/fact/schedule (обычно, регулярно, по расписанию)",
        "Continuous = process now/temporary (сейчас, в данный момент, временно)",
        "always + V-ing = раздражение (а Simple always = нейтральная привычка)"
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "en": "I usually work from home.",
          "ru": "Обычно я работаю из дома (Simple)."
        },
        {
          "en": "I'm working from home today.",
          "ru": "Сегодня я работаю из дома (Continuous)."
        },
        {
          "en": "He always forgets his keys.",
          "ru": "Он всегда забывает ключи (habit)."
        },
        {
          "en": "He's always forgetting his keys!",
          "ru": "Он постоянно забывает ключи! (annoyed)."
        }
      ]
    }
  ],
