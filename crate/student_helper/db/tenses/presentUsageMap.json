{
  "id": "presentUsageMap",
  "title": "Present Usage Map",
  "subtitle": "как выбрать настоящее время по задаче",
  "ruleBlocks": [
    {
      "type": "heading",
      "text": "Способы говорить о настоящем"
    },
    {
      "type": "text",
      "text": "Для настоящего в английском нужны разные формы: Present Simple (привычки/факты), Present Continuous (процесс сейчас/временно), Present Perfect (результат к настоящему), Present Perfect Continuous (длительность до сейчас)."
    },
    {
      "type": "table",
      "caption": "Карта выбора",
      "columns": ["Форма", "Смысл", "Формула", "Пример"],
      "rows": [
        ["Present Simple", "привычка, факт, расписание", "V1 / V-s", "She works from home."],
        ["Present Continuous", "процесс сейчас, временная ситуация", "am/is/are + V-ing", "She is working now."],
        ["Present Perfect", "результат/опыт до текущего момента", "have/has + V3", "She has finished her task."],
        ["Present Perfect Continuous", "процесс и длительность до сейчас", "have/has been + V-ing", "She has been working since 9."]
      ]
    },
    {
      "type": "highlight",
      "title": "Логика выбора",
      "lines": [
        "Рутина/факт -> Present Simple",
        "Прямо сейчас / временно -> Present Continuous",
        "Важен результат к настоящему -> Present Perfect",
        "Важна длительность процесса -> Present Perfect Continuous"
      ]
    },
    {
      "type": "examples",
      "items": [
        { "en": "I usually drink coffee in the morning.", "ru": "Я обычно пью кофе утром." },
        { "en": "I am drinking tea now.", "ru": "Я сейчас пью чай." },
        { "en": "I have already sent the email.", "ru": "Я уже отправил письмо." },
        { "en": "I have been studying for two hours.", "ru": "Я учусь уже два часа." }
      ]
    }
  ],
  "practice": {
    "exercises": [
      {
        "id": "meaning",
        "title": "Когда используем (Meaning)",
        "kind": "choice",
        "items": [
          {
            "id": "prm_m_1",
            "instruction": "Выбери форму",
            "prompt": "She usually ____ to work by bus.",
            "options": ["goes", "is going", "has gone"],
            "correctIndex": 0,
            "explain": "Обычная привычка -> Present Simple."
          },
          {
            "id": "prm_m_2",
            "instruction": "Выбери форму",
            "prompt": "Look! He ____ over there.",
            "options": ["runs", "is running", "has run"],
            "correctIndex": 1,
            "explain": "Процесс в момент речи -> Present Continuous."
          },
          {
            "id": "prm_m_3",
            "instruction": "Выбери форму",
            "prompt": "I ____ my keys, so I can't open the door.",
            "options": ["lose", "have lost", "am losing"],
            "correctIndex": 1,
            "explain": "Важен текущий результат -> Present Perfect."
          },
          {
            "id": "prm_m_4",
            "instruction": "Выбери форму",
            "prompt": "They ____ for three hours.",
            "options": ["work", "have been working", "are working"],
            "correctIndex": 1,
            "explain": "Длительность процесса -> Present Perfect Continuous."
          },
          {
            "id": "prm_m_5",
            "instruction": "Выбери форму",
            "prompt": "The meeting ____ at 10 every Monday.",
            "options": ["starts", "is starting", "has started"],
            "correctIndex": 0,
            "explain": "Регулярное расписание -> Present Simple."
          },
          {
            "id": "prm_m_6",
            "instruction": "Выбери форму",
            "prompt": "We ____ this project since January.",
            "options": ["do", "have done", "have been doing"],
            "correctIndex": 2,
            "explain": "С since + акцентом на процессе естественно Present Perfect Continuous."
          }
        ]
      },
      {
        "id": "formula",
        "title": "Формулы (Formula)",
        "kind": "input",
        "items": [
          {
            "id": "prm_f_1",
            "instruction": "Вставь форму",
            "prompt": "He ____ (work) in a bank. (fact)",
            "accepted": ["works"],
            "explain": "Факт -> Present Simple."
          },
          {
            "id": "prm_f_2",
            "instruction": "Вставь форму",
            "prompt": "She ____ (talk) on the phone right now.",
            "accepted": ["is talking"],
            "explain": "Right now -> Present Continuous."
          },
          {
            "id": "prm_f_3",
            "instruction": "Вставь форму",
            "prompt": "I ____ (already/finish) my homework.",
            "accepted": ["have already finished"],
            "explain": "already + результат -> Present Perfect."
          },
          {
            "id": "prm_f_4",
            "instruction": "Вставь форму",
            "prompt": "They ____ (study) since morning.",
            "accepted": ["have been studying"],
            "explain": "since morning + процесс -> Present Perfect Continuous."
          },
          {
            "id": "prm_f_5",
            "instruction": "Вставь форму",
            "prompt": "My sister ____ (not/like) cold weather.",
            "accepted": ["doesn't like", "does not like"],
            "explain": "Состояние/мнение -> Present Simple."
          },
          {
            "id": "prm_f_6",
            "instruction": "Исправь ошибку",
            "prompt": "I am knowing the answer.",
            "accepted": ["I know the answer."],
            "acceptedShort": ["know"],
            "explain": "know - стативный глагол, обычно используем Present Simple."
          }
        ]
      },
      {
        "id": "photoPresentPastContrast",
        "title": "Photo Set N: Present Perfect vs Past Simple in context",
        "kind": "choice",
        "items": [
          {
            "id": "prm_photo_mix_1",
            "instruction": "Выбери форму",
            "prompt": "Tom Hanks ____ an Oscar several times already.",
            "options": [
              "won",
              "has won",
              "is winning"
            ],
            "correctIndex": 1,
            "explain": "already + repeated achievement up to now -> Present Perfect."
          },
          {
            "id": "prm_photo_mix_2",
            "instruction": "Выбери форму",
            "prompt": "Nick ____ football yesterday.",
            "options": [
              "has played",
              "played",
              "has been playing"
            ],
            "correctIndex": 1,
            "explain": "yesterday = finished time -> Past Simple."
          },
          {
            "id": "prm_photo_mix_3",
            "instruction": "Выбери форму",
            "prompt": "Mary already ____ from school. Now she is doing her homework.",
            "options": [
              "came",
              "has come",
              "is coming"
            ],
            "correctIndex": 1,
            "explain": "Result now + already -> Present Perfect."
          },
          {
            "id": "prm_photo_mix_4",
            "instruction": "Выбери форму",
            "prompt": "I ____ this book last year.",
            "options": [
              "have read",
              "read",
              "have been reading"
            ],
            "correctIndex": 1,
            "explain": "last year -> Past Simple."
          },
          {
            "id": "prm_photo_mix_5",
            "instruction": "Выбери форму",
            "prompt": "I'm sorry. I ____ my homework yet.",
            "options": [
              "didn't do",
              "haven't done",
              "am not doing"
            ],
            "correctIndex": 1,
            "explain": "yet + not completed action -> Present Perfect."
          },
          {
            "id": "prm_photo_mix_6",
            "instruction": "Выбери форму",
            "prompt": "He is not at school today, he ____ ill.",
            "options": [
              "fell",
              "has fallen",
              "is falling"
            ],
            "correctIndex": 1,
            "explain": "Причина текущего состояния -> Present Perfect result."
          },
          {
            "id": "prm_photo_mix_7",
            "instruction": "Выбери форму",
            "prompt": "When ____ he ____ ill?",
            "options": [
              "has / fallen",
              "did / fall",
              "does / fall"
            ],
            "correctIndex": 1,
            "explain": "When спрашивает точный момент в прошлом -> Past Simple question."
          },
          {
            "id": "prm_photo_mix_8",
            "instruction": "Выбери форму",
            "prompt": "He ____ ill yesterday.",
            "options": [
              "has fallen",
              "fell",
              "has fell"
            ],
            "correctIndex": 1,
            "explain": "yesterday = Past Simple."
          },
          {
            "id": "prm_photo_mix_9",
            "instruction": "Выбери форму",
            "prompt": "At last I ____ all my homework: now I'll go out.",
            "options": [
              "did",
              "have done",
              "am doing"
            ],
            "correctIndex": 1,
            "explain": "Result now (now I'll go out) -> Present Perfect."
          },
          {
            "id": "prm_photo_mix_10",
            "instruction": "Выбери форму",
            "prompt": "We ____ the problem already.",
            "options": [
              "solved",
              "have solved",
              "are solving"
            ],
            "correctIndex": 1,
            "explain": "already + completed result -> Present Perfect."
          }
        ]
      },
      {
        "id": "photoPresentPastDialogues",
        "title": "Photo Set O: two-step dialogue contrasts",
        "kind": "multi_input",
        "items": [
          {
            "id": "prm_photo_dlg_1",
            "instruction": "Заполни обе формы",
            "prompt": "A: You ____ (book) tickets? B: Yes, I ____ (book) them five days ago.",
            "inputs": [
              {
                "accepted": [
                  "have booked",
                  "Have you booked"
                ]
              },
              {
                "accepted": [
                  "booked"
                ]
              }
            ],
            "explain": "В первом вопросе важен результат к now; во втором есть точное past time."
          },
          {
            "id": "prm_photo_dlg_2",
            "instruction": "Заполни обе формы",
            "prompt": "A: Are you going to finish your work before bed? B: I ____ (finish) it already. I ____ (finish) it two hours ago.",
            "inputs": [
              {
                "accepted": [
                  "have finished",
                  "I've finished"
                ]
              },
              {
                "accepted": [
                  "finished"
                ]
              }
            ],
            "explain": "already без времени -> Present Perfect; two hours ago -> Past Simple."
          },
          {
            "id": "prm_photo_dlg_3",
            "instruction": "Заполни обе формы",
            "prompt": "A: Do you want to go to the movie tonight? B: No, thanks. We ____ (see) it already. We ____ (see) it last week.",
            "inputs": [
              {
                "accepted": [
                  "have seen",
                  "We've seen"
                ]
              },
              {
                "accepted": [
                  "saw"
                ]
              }
            ],
            "explain": "already -> Present Perfect, last week -> Past Simple."
          },
          {
            "id": "prm_photo_dlg_4",
            "instruction": "Заполни обе формы",
            "prompt": "Tom ____ (break) his leg five days ago. He ____ (be) in hospital since he ____ (break) his leg.",
            "inputs": [
              {
                "accepted": [
                  "broke"
                ]
              },
              {
                "accepted": [
                  "has been"
                ]
              }
            ],
            "explain": "Первое - Past Simple (five days ago), второе - Present Perfect (since + point)."
          }
        ]
      }
    ]
  }
}
