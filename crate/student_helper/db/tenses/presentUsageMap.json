              },
              {
                "accepted": [
                  "has been"
                ]
              },
              {
                "accepted": [
                  "broke"
                ]
              }
            ],
            "explain": "Первое и третье - Past Simple (break -> broke), второе - Present Perfect (since + point)."
          }
        ]
