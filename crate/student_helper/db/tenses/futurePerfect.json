{
  "id": "futurePerfect",
  "title": "Future Perfect",
  "subtitle": "действие завершится к моменту в будущем",
  "ruleBlocks": [
    {
      "type": "heading",
      "text": "Когда используем Future Perfect"
    },
    {
      "type": "text",
      "text": "Future Perfect (will have + V3) показывает, что действие будет завершено к определенному моменту в будущем."
    },
    {
      "type": "highlight",
      "title": "Ключевая идея",
      "lines": [
        "смотрим из будущей точки назад: к тому времени действие уже закончится",
        "часто с by, by the time, before"
      ]
    },
    {
      "type": "table",
      "caption": "Формулы",
      "columns": [
        "Тип",
        "Формула",
        "Пример"
      ],
      "rows": [
        [
          "Утверждение",
          "S + will have + V3",
          "I will have finished by 6."
        ],
        [
          "Отрицание",
          "S + will not have + V3",
          "I won't have finished by 6."
        ],
        [
          "Вопрос",
          "Will + S + have + V3?",
          "Will you have finished by 6?"
        ]
      ]
    },
    {
      "type": "table",
      "caption": "Маркеры",
      "columns": [
        "Тип",
        "Маркеры"
      ],
      "rows": [
        [
          "срок",
          "by 5 o'clock, by tomorrow, by next week"
        ],
        [
          "граница",
          "by the time, before"
        ],
        [
          "контекст",
          "in two years (к этому времени), by then"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "Future Perfect vs Future Continuous"
    },
    {
      "type": "highlight",
      "title": "Разница",
      "lines": [
        "Future Perfect = результат к моменту (will have done)",
        "Future Continuous = процесс в моменте (will be doing)"
      ]
    }
  ],
