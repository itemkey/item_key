          "more + adverb",
          "most + adverb",
          "more carefully -> most carefully"
        ],
        [
          "снижение степени",
          "less + adverb",
          "least + adverb",
          "less often -> least often"
        ],
        [
          "irregular",
          "better / worse / more / less",
          "best / worst / most / least",
          "well -> better -> best; badly -> worse -> worst"
        ]
