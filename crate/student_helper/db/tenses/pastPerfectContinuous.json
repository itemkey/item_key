{
  "id": "pastPerfectContinuous",
  "title": "Past Perfect Continuous",
  "subtitle": "длительность процесса до момента в прошлом",
  "ruleBlocks": [
    {
      "type": "heading",
      "text": "Когда используем Past Perfect Continuous"
    },
    {
      "type": "text",
      "text": "Past Perfect Continuous показывает процесс, который длился до определенного момента в прошлом. Важно не только что действие было, но и как долго оно продолжалось."
    },
    {
      "type": "highlight",
      "title": "Ключевые случаи",
      "lines": [
        "длительность до момента в прошлом: She had been studying for two hours before dinner.",
        "причина результата в прошлом: He was tired because he had been running.",
        "вопрос how long до past point: How long had you been waiting before the bus came?"
      ]
    },
    {
      "type": "table",
      "caption": "Формулы",
      "columns": [
        "Тип",
        "Формула",
        "Пример"
      ],
      "rows": [
        [
          "Утверждение",
          "S + had been + V-ing",
          "I had been working all day."
        ],
        [
          "Отрицание",
          "S + had not (hadn't) been + V-ing",
          "I hadn't been sleeping well."
        ],
        [
          "Вопрос",
          "Had + S + been + V-ing?",
          "Had you been waiting long?"
        ]
      ]
    },
    {
      "type": "table",
      "caption": "Маркеры",
      "columns": [
        "Тип",
        "Маркеры"
      ],
      "rows": [
        [
          "длительность",
          "for two hours, for a long time"
        ],
        [
          "точка отсчета",
          "since morning, since 5 o'clock"
        ],
        [
          "граница во времени",
          "before, until, by the time"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "Past Perfect vs Past Perfect Continuous"
    },
    {
      "type": "highlight",
      "title": "Разница",
      "lines": [
        "Past Perfect = результат к моменту в прошлом (had done)",
        "Past Perfect Continuous = длительность/процесс до момента в прошлом (had been doing)"
      ]
    },
    {
      "type": "examples",
      "items": [
        {
          "en": "She had written five emails before lunch.",
          "ru": "К обеду она написала пять писем (результат)."
        },
        {
          "en": "She had been writing emails for two hours before lunch.",
          "ru": "Перед обедом она писала письма два часа (процесс и длительность)."
        }
      ]
    }
  ],
