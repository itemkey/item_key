            "explain": "Это план группы людей, уже решенный."
          },
          {
            "id": "fpcf_m_6",
            "instruction": "Выбери объяснение",
            "prompt": "I'm seeing my coach after work.",
            "options": ["договоренность", "прошлое действие", "желание"],
            "correctIndex": 0,
            "explain": "Назначенная встреча после работы."
          }
        ]
      },
      {
        "id": "formula",
        "title": "Формулы (Formula)",
        "kind": "input",
        "items": [
          {
            "id": "fpcf_f_1",
            "instruction": "Вставь форму",
            "prompt": "I ____ (meet) Sarah tonight.",
            "accepted": ["am meeting"],
            "explain": "I + am + V-ing."
          },
          {
            "id": "fpcf_f_2",
            "instruction": "Вставь форму",
            "prompt": "They ____ (fly) to Berlin next week.",
            "accepted": ["are flying"],
            "explain": "They + are + V-ing."
          },
          {
            "id": "fpcf_f_3",
            "instruction": "Сделай отрицание",
            "prompt": "She ____ (not/work) tomorrow.",
            "accepted": ["isn't working", "is not working"],
            "explain": "Отрицание: is not + V-ing."
          },
          {
            "id": "fpcf_f_4",
            "instruction": "Сделай вопрос",
            "prompt": "____ you ____ (come) with us tonight?",
            "accepted": ["Are you coming"],
            "explain": "Вопрос: Are + S + V-ing?"
          },
          {
            "id": "fpcf_f_5",
            "instruction": "Вставь форму",
            "prompt": "We ____ (have) lunch with clients tomorrow.",
            "accepted": ["are having"],
            "explain": "We + are having (arrangement)."
          },
          {
            "id": "fpcf_f_6",
            "instruction": "Сделай вопрос",
            "prompt": "____ he ____ (stay) here this weekend?",
            "accepted": ["Is he staying"],
            "explain": "He -> Is he staying...?"
          }
        ]
      }
    ]
  }
}
